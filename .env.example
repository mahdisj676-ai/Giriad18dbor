# Required
BOT_TOKEN=
OWNER_IDS=123456789

# Optional AI services. Without API keys the bot relies on the local NudeNet detector
# and configured keyword filters. Cloud/AI use may create third-party processing costs.
GOOGLE_VISION_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GOOGLE_DAILY_CAP=100
ANTHROPIC_DAILY_CAP=250
AI_TEXT_ALL=0

# Defaults for newly added groups
DEFAULT_ENGINE=smart
DEFAULT_LEVEL=mid
LOG_LEVEL=INFO
# DB_PATH=/opt/guardbot/data/guardbot.sqlite3
